# Copiá este archivo como .env y completá tus datos (el .env NO se sube a GitHub).
# Si la clave tiene caracteres especiales (@ : / # %), hay que codificarlos (ej. @ -> %40).
DATABASE_URL=mysql+pymysql://usuario:clave@localhost:3306/soai

# Le dice a "flask" cuál es la app (así alcanza con escribir: flask run)
FLASK_APP=app.py
FLASK_DEBUG=1

# Dirección desde donde se abre el frontend (para CORS)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
